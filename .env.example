# Supabase (usar SOLO en el servidor; nunca exponer SERVICE_ROLE al cliente)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE=

# Stripe
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Google OAuth se configura en el dashboard de Supabase
# (Authentication > Providers > Google), no aquí.

# Aviso de venta por Gmail. GMAIL_APP_PASSWORD es una "contraseña de
# aplicación" de Google, no la contraseña normal de la cuenta, y debe
# haberse generado con la misma cuenta que va en GMAIL_USER.
# NOTIFY_EMAIL es a dónde llega el aviso; puede ser otra cuenta.
GMAIL_USER=
GMAIL_APP_PASSWORD=
NOTIFY_EMAIL=

# Dominio real donde corre la app. Se usa para los retornos de Stripe y Google,
# así que debe apuntar al sitio en vivo (en local: http://localhost:3000).
NEXT_PUBLIC_SITE_URL=
